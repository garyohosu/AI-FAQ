# AI-FAQ 環境変数サンプル。秘密情報(APIキー等)は含みません。
# 実際に使う場合は `.env.example` をコピーして `.env` を作成してください
# (このリポジトリは .env を自動読込しません。シェルの環境変数として
# エクスポートするか、お使いのプロセスマネージャで設定してください)。

# SQLite DBのパス (業務データ + LangGraphチェックポイント)
AIFAQ_DB_PATH=data/aifaq.db

# Gemini CLI実行ファイル名または絶対パス
AIFAQ_GEMINI_BIN=gemini

# Web調査のタイムアウト秒数
AIFAQ_RESEARCH_TIMEOUT=60

# Gemini CLI出力の最大保存文字数
AIFAQ_MAX_OUTPUT_CHARS=20000

# 承認済み知識のマッチ閾値 (0.0-1.0)
AIFAQ_KNOWLEDGE_THRESHOLD=0.55

# AI調査結果を暫定回答として採用する信頼度閾値 (0.0-1.0)
AIFAQ_RESEARCH_CONFIDENCE_THRESHOLD=0.6

# 知識・メモリーディレクトリ
AIFAQ_KNOWLEDGE_DIR=knowledge
AIFAQ_MEMORY_DIR=memory
AIFAQ_MEMORY_INDEX=MEMORY.md

# 確認質問の最大ラウンド数 (3を超える値は設定できません)
AIFAQ_MAX_CLARIFICATION_ROUNDS=3

# ログレベル
AIFAQ_LOG_LEVEL=INFO
